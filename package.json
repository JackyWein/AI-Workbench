{
  "name": "ai-workbench",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Local desktop environment for multiple AI providers, sessions, skills and autonomous teams",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @ai-workbench/desktop dev",
    "postinstall": "node scripts/fix-pty-permissions.mjs",
    "build": "pnpm --filter @ai-workbench/desktop build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @ai-workbench/database generate",
    "verify": "pnpm verify:lockfile && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:app",
    "lint": "eslint .",
    "verify:app": "bash scripts/verify-app.sh",
    "package": "pnpm --filter @ai-workbench/desktop package",
    "verify:lockfile": "pnpm install --lockfile-only --frozen-lockfile"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "eslint": "^9.18.0",
    "typescript-eslint": "^8.20.0",
    "@eslint/js": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JackyWein/AI-Workbench.git"
  }
}
