{
  "name": "ai-workbench",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "description": "Local desktop environment for multiple AI providers, sessions, skills and autonomous teams",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun run --filter \"@ai-workbench/desktop\" dev",
    "postinstall": "node scripts/fix-pty-permissions.mjs",
    "build": "bun run --filter \"@ai-workbench/desktop\" build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "bun run --filter \"@ai-workbench/database\" generate",
    "verify": "bun run verify:lockfile && bun run lint && bun run typecheck && bun run test && bun run build && bun run verify:app",
    "lint": "eslint .",
    "verify:app": "bash scripts/verify-app.sh",
    "check:providers": "bun scripts/check-providers.ts",
    "package": "bun run --filter \"@ai-workbench/desktop\" package",
    "verify:lockfile": "bun install --frozen-lockfile"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "eslint": "^9.18.0",
    "typescript-eslint": "^8.20.0",
    "@eslint/js": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JackyWein/AI-Workbench.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/providers/*",
    "packages/providers/transports/*"
  ],
  "trustedDependencies": [
    "electron",
    "esbuild",
    "node-pty"
  ]
}
